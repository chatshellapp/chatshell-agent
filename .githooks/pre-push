#!/bin/sh
# Quality gate for pushes: offline, deterministic checks only.
#
# Runs the Rust gate (fmt, clippy, cargo test) for the workspace. Network
# and real-API evals (the #[ignore] tests) are deliberately excluded —
# they need credentials or the live internet and are run by hand via
# `cargo test -- --ignored`.
#
# Bypass for WIP pushes: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

echo "== [pre-push] rust: fmt + clippy + cargo test =="
cargo fmt --all -- --check
cargo clippy --all-targets --quiet
cargo test
